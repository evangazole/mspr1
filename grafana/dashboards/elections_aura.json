    {
      "id": 10,
      "type": "text",
      "title": "",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "options": {
        "content": "## Courbes temporelles — Évolution 2022–2028",
        "mode": "markdown"
      },
      "transparent": true
    },

    {
      "id": 6,
      "type": "timeseries",
      "title": "Évolution du nombre de communes par bloc (2022 → 2028)",
      "description": "2022 = résultats réels · 2026/2027/2028 = prédictions Random Forest (horizons +1/+2/+3 ans)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "postgres", "uid": "elections-postgres" },
      "targets": [
        {
          "rawSql": "SELECT make_timestamp(annee, 7, 1, 0, 0, 0) AS \"time\", MAX(CASE WHEN bloc = 'G'  THEN communes END) AS \"Gauche\", MAX(CASE WHEN bloc = 'C'  THEN communes END) AS \"Centre\", MAX(CASE WHEN bloc = 'D'  THEN communes END) AS \"Droite\", MAX(CASE WHEN bloc = 'ED' THEN communes END) AS \"Extrême Droite\" FROM evolution_blocs GROUP BY annee ORDER BY annee",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "lines": true,
        "points": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 3,
            "pointSize": 8,
            "lineInterpolation": "smooth",
            "spanNulls": true,
            "fillOpacity": 10
          },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Gauche"          }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4caf94" } }] },
          { "matcher": { "id": "byName", "options": "Centre"          }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4a90d9" } }] },
          { "matcher": { "id": "byName", "options": "Droite"          }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3e7de8" } }] },
          { "matcher": { "id": "byName", "options": "Extrême Droite"  }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e05c5c" } }] }
        ]
      }
    },

    {
      "id": 20,
      "type": "text",
      "title": "",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "options": {
        "content": "## Carte de chaleur — Variations relatives vs 2022",
        "mode": "markdown"
      },
      "transparent": true
    },

    {
      "id": 7,
      "type": "barchart",
      "title": "Variations en points de % vs 2022 — par bloc et horizon temporel",
      "description": "Delta = (communes_horizon / total) - (communes_2022 / total). Positif = gain de communes, négatif = perte.",
      "gridPos": { "h": 10, "w": 14, "x": 0, "y": 16 },
      "datasource": { "type": "postgres", "uid": "elections-postgres" },
      "targets": [
        {
          "rawSql": "SELECT CASE bloc WHEN 'G' THEN 'Gauche' WHEN 'C' THEN 'Centre' WHEN 'D' THEN 'Droite' WHEN 'ED' THEN 'Extrême Droite' END AS \"Bloc\", MAX(CASE WHEN annee = 2026 THEN delta_pct END) AS \"+1 an (2026)\", MAX(CASE WHEN annee = 2027 THEN delta_pct END) AS \"+2 ans (2027)\", MAX(CASE WHEN annee = 2028 THEN delta_pct END) AS \"+3 ans (2028)\" FROM variations_2022 GROUP BY bloc ORDER BY bloc",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "xTickLabelRotation": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 80 },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "+1 an (2026)"  }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "rgba(108,99,255,0.5)"  } }] },
          { "matcher": { "id": "byName", "options": "+2 ans (2027)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "rgba(108,99,255,0.75)" } }] },
          { "matcher": { "id": "byName", "options": "+3 ans (2028)" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "rgba(108,99,255,0.95)" } }] }
        ]
      }
    },

    {
      "id": 8,
      "type": "barchart",
      "title": "Répartition des communes 2027 — comparaison 4 modèles",
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 16 },
      "datasource": { "type": "postgres", "uid": "elections-postgres" },
      "targets": [
        {
          "rawSql": "SELECT CASE model_name WHEN 'random_forest' THEN 'Random Forest' WHEN 'extra_trees' THEN 'Extra Trees' WHEN 'knn' THEN 'KNN' WHEN 'logistic' THEN 'Rég. Logistique' END AS \"Modèle\", COUNT(*) FILTER (WHERE prediction = 'G')  AS \"Gauche\", COUNT(*) FILTER (WHERE prediction = 'C')  AS \"Centre\", COUNT(*) FILTER (WHERE prediction = 'D')  AS \"Droite\", COUNT(*) FILTER (WHERE prediction = 'ED') AS \"Extrême Droite\" FROM predictions GROUP BY model_name ORDER BY model_name",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "stacking": "normal"
      },
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 80 }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Gauche"         }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4caf94" } }] },
          { "matcher": { "id": "byName", "options": "Centre"         }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#4a90d9" } }] },
          { "matcher": { "id": "byName", "options": "Droite"         }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#3e7de8" } }] },
          { "matcher": { "id": "byName", "options": "Extrême Droite" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#e05c5c" } }] }
        ]
      }
    },

    {
      "id": 30,
      "type": "text",
      "title": "",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "options": {
        "content": "## Diagrammes de probabilité — Distribution des scores de confiance (Random Forest)",
        "mode": "markdown"
      },
      "transparent": true
    },

    {
      "id": 9,
      "type": "barchart",
      "title": "Distribution des probabilités — Extrême Droite",
      "description": "Score de confiance du modèle Random Forest pour chaque commune (0 = très incertain, 1 = très certain). Une commune est prédite ED quand sa probabilité ED est la plus haute.",
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 27 },
      "datasource": { "type": "postgres", "uid": "elections-postgres" },
      "targets": [
        {
          "rawSql": "SELECT ROUND(prob_min::numeric * 100)::text || '%' AS \"Probabilité\", communes AS \"Communes\" FROM proba_distribution WHERE bloc = 'ED' ORDER BY prob_min",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "auto",
        "groupWidth": 0.97,
        "barWidth": 0.97,
        "tooltip": { "mode": "single", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "xTickLabelRotation": -45
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "#e05c5c" }, "custom": { "fillOpacity": 75 }, "unit": "short" },
        "overrides": []
      }
    },

    {
      "id": 11,
      "type": "barchart",
      "title": "Distribution des probabilités — Gauche",
      "description": "Score de confiance du modèle Random Forest pour le bloc Gauche.",
      "gridPos": { "h": 10, "w": 8, "x": 8, "y": 27 },
      "datasource": { "type": "postgres", "uid": "elections-postgres" },
      "targets": [
        {
          "rawSql": "SELECT ROUND(prob_min::numeric * 100)::text || '%' AS \"Probabilité\", communes AS \"Communes\" FROM proba_distribution WHERE bloc = 'G' ORDER BY prob_min",
