      "targets": [
        {
          "rawSql": "SELECT ROUND(prob_min::numeric * 100)::text || '%' AS \"Probabilité\", communes AS \"Communes\" FROM proba_distribution WHERE bloc = 'C' ORDER BY prob_min",
          "format": "table",
