    {
      "id": 5,
      "type": "stat",
      "title": "Concordance inter-modèles",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "elections-postgres" },
      "targets": [
        {
          "rawSql": "SELECT ROUND(100.0 * SUM(CASE WHEN agree THEN 1 ELSE 0 END) / COUNT(*), 1) AS value FROM (SELECT code_geo, COUNT(DISTINCT prediction) = 1 AS agree FROM predictions GROUP BY code_geo) t",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
