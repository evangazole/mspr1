        "overrides": []
      }
    },

    {
      "id": 40,
      "type": "text",
      "title": "",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 37 },
      "options": {
        "content": "## Analyse géographique — Résultats par département",
        "mode": "markdown"
      },
      "transparent": true
    },

    {
      "id": 13,
      "type": "table",
      "title": "Résultats par département (Random Forest 2027)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 38 },
      "datasource": { "type": "postgres", "uid": "elections-postgres" },
      "targets": [
        {
          "rawSql": "SELECT dept_code AS \"Dép.\", COUNT(*) AS \"Communes\", COUNT(*) FILTER (WHERE prediction = 'ED') AS \"ED\", COUNT(*) FILTER (WHERE prediction = 'C')  AS \"Centre\", COUNT(*) FILTER (WHERE prediction = 'G')  AS \"Gauche\", COUNT(*) FILTER (WHERE prediction = 'D')  AS \"Droite\", MODE() WITHIN GROUP (ORDER BY prediction) AS \"Dominant\", ROUND(100.0 * COUNT(*) FILTER (WHERE prediction = 'ED') / COUNT(*), 1) AS \"% ED\" FROM predictions WHERE model_name = 'random_forest' GROUP BY dept_code ORDER BY dept_code",
          "format": "table",
          "refId": "A"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "% ED" }],
        "footer": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto",
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "% ED" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "continuous-RdYlGn" } },
              { "id": "thresholds", "value": { "mode": "percentage", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 80 }] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Dominant" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-text" },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "ED": { "color": "#e05c5c", "index": 0 } } },
                  { "type": "value", "options": { "C":  { "color": "#4a90d9", "index": 1 } } },
                  { "type": "value", "options": { "G":  { "color": "#4caf94", "index": 2 } } },
                  { "type": "value", "options": { "D":  { "color": "#3e7de8", "index": 3 } } }
                ]
              }
            ]
          }
        ]
      }
    }

