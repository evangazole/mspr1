    },

    {
      "id": 12,
      "type": "barchart",
      "title": "Distribution des probabilités — Centre",
      "description": "Score de confiance du modèle Random Forest pour le bloc Centre.",
      "gridPos": { "h": 10, "w": 8, "x": 16, "y": 27 },
